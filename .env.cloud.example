# =============================================================================
# 阿卡莉 1.0 环境变量 · 【云服务器模板（文档版）】
#
# 用法（在服务器上的项目根目录执行）：
#     cp .env.cloud.example .env
#     # 填好 3 个「必填项」（AGICTO_API_KEY、AKALI_OWNER_TOKEN、AKALI_INVITE_CODE）后：
#     docker compose up -d --build
#
# 本文件是「云服务器部署模板」，已把云端必填项预填好（AKALI_PROXY_HEADERS=1、
# FX_CLOUD_MODE=on、AKALI_NO_BROWSER=1、AKALI_USERS_FILE 等），其余变量含义与本文件注释一致。
# 各变量完整说明与样例也见 环境变量配置说明.md。
# =============================================================================


# ═══════════ 必填 ①：LLM 密钥 ═══════════
# 服务商（agicto / dashscope）：决定接口地址与读取哪个 API Key 变量
LLM_PROVIDER=agicto

# API Key（AGICTO 从 https://agicto.com 获取，DashScope 从 https://dashscope.console.aliyun.com 获取）
# 注意：生产环境建议用系统环境变量而非 .env 保存密钥
AGICTO_API_KEY=                     # ← 填这里（或改用 DASHSCOPE_API_KEY + LLM_PROVIDER=dashscope）
DASHSCOPE_API_KEY=
LLM_MODEL=qwen-plus
LLM_ENABLE_THINKING=0
EMBEDDING_MODEL=text-embedding-v4


# ═══════════ 必填 ②：账号与准入（公网必须填）═══════════
# 用户口径 2026-09-25：**口令、准入开关、可用账号全部在这里控制**，改完执行
#     docker compose up -d --force-recreate akali
# 即生效。这些内容只存在于服务器上；想核对谁在用，可调 GET /api/admin/accounts
# （仅开发者口令可调，返回当前账号与开关）。

# 【0 号用户 · 开发者本人】你自己的口令。留空则回落 AKALI_INVITE_CODE；
# 若三者皆空 = 不校验（公网暴露会被白嫖 LLM 额度），故公网部署务必填一个。
AKALI_OWNER_UID=000000
AKALI_OWNER_TOKEN=

# 【注册邀请码】发出去的"入场券"，所有人共用（用户口径 2026-09-25）。
# 用户拿到「网址 + 邀请码」后打开即自动注册（不用自己填 uid、也不用你手改 json）：
#   · 带码打开：http://<IP>/?invite=<下面的值>  → 自动分配 uid + 生成他的个人口令
#   · 同一台设备（同 device_id）再打开 → 直接回位，不会重复注册
#   · 换设备 → 让用户输入这个邀请码，会给他一个新账号（或他自己输已有口令登录）
# 留空 = 关闭注册（只允许已有口令登录）。
AKALI_INVITE_CODE=

# 【是否允许自助注册】留空 = 跟随总开关（AKALI_ALLOW_OTHER_USERS）
# 想"停止进新人、但已注册的人照常用" → 这里设 false
# AKALI_ALLOW_REGISTER=true

# 【准入总开关】true = 允许其他人使用；false = **只有开发者本人能用**
# 想临时「关掉其他所有人、但我自己照常跑」，把这行改成 false 再重启容器即可。
AKALI_ALLOW_OTHER_USERS=true

# 【管理白名单】谁可以访问「开发者侧」的运营内容（用量视图 / 账号与准入 等）。
# 逗号分隔 uid；**默认只含开发者本人**（AKALI_OWNER_UID），留空即默认。
# 想授权给某个测试用户看用量，把他的 uid 加进来即可（例如 000000,000003）。
# 注意：不在白名单内的 uid 调 /api/admin/* 一律 403；普通用户只能访问只读的 /api/me。
# AKALI_ADMIN_UIDS=000000

# 【测试用户】**单独放在外层 users.json**（用户口径 2026-09-25），不写在 .env 里。
#   · 文件位置：项目根 users.json（云端已挂载到宿主机，直接编辑即可）
#   · 格式：{"users": {"000001": {"name": "小明", "token": "口令", "user_uid": "10000001", "enabled": true, "plan": "free"}}}
#   · 内部 uid 六位、从 000001 起编号（仅存储/排序）；user_uid 是用户注册时自填的八位号（首位 1/3/6/8，网页展示）
#   · 000000 是开发者本人（在上面配），不写在这张表里
#   · 套餐档（可选）：plan = free（默认）/ paid（付费，旧名 month 等同）/ unlimited（不限量）
#   · **改完立即生效、无需重启**（服务端按文件 mtime 自动重载）
#   · 新增：加一项；删除：删掉那一项；临时停用：enabled 改 false
#   · 对方浏览器缓存的口令不用管 —— 服务端不认了他就收到 401，页面会自动重新弹口令框
#   · 生成口令的小工具（在服务器上执行，复制输出填进 users.json）：
#       python3 -c "import secrets;print(''.join(secrets.choice('abcdefghijkmnpqrstuvwxyz23456789') for _ in range(16)))"
# 兼容保留（旧写法，逗号分隔；users.json 存在时以文件为准）：AKALI_USERS=
AKALI_USERS=
# 用户表路径（命名卷挂载点；必须与 docker-compose.yml 的 akali_users 卷一致）
AKALI_USERS_FILE=/app/users_data/users.json


# ═══════════ 必填 ③：无（其余已配好）═══════════

# --- 云端运行模式 ---
AKALI_RUN_MODE=cloud
HOST=0.0.0.0                # 必须 0.0.0.0，否则容器外访问不到
PORT=8000
AKALI_NO_BROWSER=1          # 服务器无需自动开浏览器
AKALI_PROXY_HEADERS=1       # 经 nginx 必须置 1，否则按 IP 限额会全员算作同一 IP
AKALI_PANEL_STORE=client    # 面板随请求携带、存浏览器本地（服务器无用户文件）
FX_CLOUD_MODE=on            # 启用多用户算力配额


# --- 多用户算力配额（不想限额就整段注释掉）---
FX_QUOTA_BACKEND=redis              # compose 内置 redis，跨重启不丢
FX_REDIS_URL=redis://redis:6379/0   # redis 为 docker-compose 内的服务名
FX_QUOTA_DIR=/data/quota
# 各档额度每周期（周四→下周四）token 上限（直接读 env；设 0 = 不限量）
FX_QUOTA_FREE=300000          # 免费档每周期（周四→下周四）token 上限（30w）
FX_QUOTA_PAID=300000          # 付费档每周期（周四→下周四）token 上限（30w）
FX_QUOTA_WHITELIST=300000     # 白名单每周期（周四→下周四）token 上限（30w；类似开发者，独立可调）
FX_QUOTA_WHITELIST_KEYS=      # 白名单 IP/uid 列表，逗号分隔（如 1.2.3.4,000001）


# --- 知识库问答命中缓存（只缓存「攻略问答」类答复：同一问题重复问不再重算）---
# 边界：闲聊/调情/计算/查询/表单**不缓存**（它们依赖会话上下文与人设）。
# 键 = 问题 + 玩家身份 + 实际检索 query + 知识库版本，改库后自动整体失效。
# 进程内缓存：容器重建后清零（首问会重新算一遍，随后恢复命中）。
AKALI_KB_CACHE=1              # 1=开（默认）0=关
AKALI_KB_CACHE_TTL=86400      # 条目有效期（秒，默认 1 天）
AKALI_KB_CACHE_MAX=256        # 最多缓存 256 个问题（超出丢最旧）
AKALI_KB_CACHE_CHARGE=1       # 命中时照常记账（1=默认；0=命中不记，等于白送额度）


# --- 舰船「就业/用途」问答的 LLM 归纳（证据不足时才用，带自评把关）---
# 问「X 有什么用/就业」时：攻略里有明确「定位：…」行 → 原文直出（不花 token）。
# 只有零散提及（如竞技场阵容点名过）或完全查不到 → LLM 简短归纳 + 自评，
# 自评不通过就回落诚实兜底（不硬编）。设 0 则完全不用 LLM（一律只走原文/兜底）。
AKALI_SHIP_USE_LLM=1


# --- 对外链接（可选：买了域名 / CDN / 对象存储再填）---
# 说明：全部留空即可正常对外服务 —— 素材走服务器 /kb/ 路由，知识库用本地 知识库/ 目录。
# 跨域白名单（网页端/iframe 从他域访问时填，逗号分隔；同源部署留空）
AKALI_ALLOW_ORIGINS=
# 图片素材 CDN（指向 知识库/图片素材/）
FX_CDN_BASE=
# 知识库对象存储同步（不配则用服务器上挂载的 知识库/ 目录）
FX_KB_SYNC=
FX_KB_BASE_URL=
FX_KB_MANIFEST_URL=
FX_CLOUD_CACHE_DIR=
