# =============================================================================
# 阿卡莉 1.0 环境变量 · 【本地自用模板】
#
# 用法：复制本文件为 .env（copy .env.example .env），**默认即可直接用** ——
#       只监听 127.0.0.1、无门禁、无限额，不需要额外配置任何东西。
#
# 要部署到云服务器？用另一个模板：
#       cp .env.cloud.example .env        # 【云服务器模板】含云端模式/口令/配额/白名单
# =============================================================================


# --- 核心 LLM 配置 ---
# 服务商（agicto / dashscope）：决定接口地址与读取哪个 API Key 变量
LLM_PROVIDER=agicto

# API Key（AGICTO 从 https://agicto.com 获取，DashScope 从 https://dashscope.console.aliyun.com 获取）
# 注意：生产环境建议用系统环境变量而非 .env 保存密钥
AGICTO_API_KEY=
DASHSCOPE_API_KEY=

# LLM 模型名
LLM_MODEL=qwen-plus

# 思考模式开关（默认 0 关闭；qwen3 系列非流式调用必须关闭，否则上游 400）
LLM_ENABLE_THINKING=0

# 向量模型（攻略问答库向量化，走所选服务商 /v1/embeddings）
EMBEDDING_MODEL=text-embedding-v4


# --- 路由与功能开关 ---
# 路由模式：agent=LangChain function calling 选工具（默认）/ legacy=旧正则回退
AKALI_ROUTE_MODE=agent
# agent 模式绑定工具范围：core=12 个只读工具(默认) / full=追加更多只读工具
# AKALI_AGENT_TOOLS=core
# 聊天功能开关（默认开启，设为 0 或 false 则禁用所有 LLM 对话）
AKALI_CHAT_ENABLED=


# --- 心跳与生命周期 ---
# 自动关闭：页面关闭后自动终止服务（本地便利，云端勿开）
AKALI_AUTO_SHUTDOWN=
AKALI_HEARTBEAT_TIMEOUT=120
AKALI_HEARTBEAT_INTERVAL=30


# ═══════════ 账号与准入（本地通常全留空；要给别人用才填）═══════════
# 用户口径 2026-09-25：口令、准入开关、可用账号**全部由这里控制**（云端可直接改本文件）。
# 完整说明见 .env.cloud.example 的同名段落，这里只放最简用法：
#
#   0 号用户（你自己）的口令；留空 = 本机不校验
#   兼容旧名：留空时会回落 AKALI_INVITE_CODE / API_TOKEN
AKALI_OWNER_UID=000000
AKALI_OWNER_TOKEN=

#   总开关：true 允许下面的测试用户；false = 只有你自己能用
AKALI_ALLOW_OTHER_USERS=true

#   测试用户：uid:口令[:备注]，英文逗号分隔（uid 六位，000001 起）
#   例：AKALI_USERS=000001:k7m2p9qrs4tvwx3z:小明
AKALI_USERS=

# 旧名（兼容保留，新部署请用上面的 AKALI_OWNER_TOKEN）
API_TOKEN=


# --- 本地运行参数（保持默认即可）---
AKALI_RUN_MODE=local          # 本地个人模式：127.0.0.1 + 无门禁 + 无限额
HOST=127.0.0.1                # 仅本机访问
PORT=8000                     # 端口冲突时自动顺延 8001-8009
AKALI_NO_BROWSER=             # 留空 = 启动后自动打开浏览器
AKALI_PROXY_HEADERS=          # 留空 = 不走反代（本机直连）
AKALI_PANEL_STORE=            # 留空 = 按模式自动（本地→server：落盘 user_data.json）
FX_CLOUD_MODE=                # 留空 = 不启用多用户配额（本地不限量）
AKALI_AUTO_KILL=1             # 端口冲突时自动杀死占用进程（本地便利开关）


# --- 开发者入口配置（仅数据管理工具使用，服务端可留空）---
# KNOWLEDGE_BASE_DIR=
# RAW_DATA_OUTPUT_PATH=
# DATA_OUTPUT_PATH=
