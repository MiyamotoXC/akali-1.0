# =============================================================================
# 阿卡莉 1.0 环境变量配置模板
# 使用方法：复制本文件为 .env，填入实际值后启动服务
#   copy .env.example .env
#   python 用户端特用/web_app.py
# =============================================================================

# --- 核心 LLM 配置 ---
# 服务商（agicto / dashscope）：决定接口地址与读取哪个 API Key 变量
LLM_PROVIDER=agicto

# API Key（填写所用服务商对应的变量；AGICTO 从 https://agicto.com 获取，
# DashScope 从 https://dashscope.console.aliyun.com 获取）
# 注意：生产环境建议用系统环境变量而非 .env 保存密钥
AGICTO_API_KEY=
DASHSCOPE_API_KEY=

# LLM 模型名
LLM_MODEL=qwen-plus

# 思考模式开关（可选，默认 0 关闭；qwen3 系列非流式调用必须关闭，否则上游 400）
LLM_ENABLE_THINKING=0

# 向量模型（攻略问答库向量化，走所选服务商 /v1/embeddings）
EMBEDDING_MODEL=text-embedding-v4

# --- Web 服务配置 ---
# 监听地址（默认 127.0.0.1 仅本机访问）
HOST=127.0.0.1

# 监听端口（默认 8000，冲突时自动顺延到 8001-8009）
PORT=8000

# 关闭浏览器自动打开（设为 1 则不自动打开页面）
AKALI_NO_BROWSER=

# 端口冲突时自动杀死占用进程（设为 1 启用）
AKALI_AUTO_KILL=1

# --- 心跳与生命周期 ---
# 自动关闭：页面关闭后自动终止服务（默认关闭，设为 1 启用）
AKALI_AUTO_SHUTDOWN=

# 心跳超时秒数（默认 120，超过此时间无心跳视为页面关闭）
AKALI_HEARTBEAT_TIMEOUT=120

# 心跳发送间隔秒数（默认 30）
AKALI_HEARTBEAT_INTERVAL=30

# --- 功能开关 ---
# 聊天功能开关（默认开启，设为 0 或 false 则禁用所有 LLM 对话）
AKALI_CHAT_ENABLED=

# 路由模式：agent=LangChain function calling 选工具（默认）/ legacy=旧正则回退
# agent 模式下 LLM 只负责「选工具+抽参数」，工具确定性执行、回复原文直出；
# 未命中工具时回落 legacy。详见 通用工具/core/route_dispatch.py
AKALI_ROUTE_MODE=agent

# agent 模式绑定工具范围：core=12 个只读读/检索工具(默认) / full=追加更多只读工具
# AKALI_AGENT_TOOLS=core

# --- 开发者入口配置（仅数据管理工具使用）---
# 知识库根目录（可选，默认 知识库/）
# KNOWLEDGE_BASE_DIR=

# 原始数据输出路径（可选，默认 知识库/底层数据/产物/raw_data.json）
# RAW_DATA_OUTPUT_PATH=

# 处理后数据输出路径（可选，默认 知识库/底层数据/产物/data.json）
# DATA_OUTPUT_PATH=

# --- 安全 ---
# API Token（可选，用于前端简易鉴权；留空则不校验）
API_TOKEN=

# --- 云端多用户（可选；全部留空则本地个人模式，行为不变）---
# 云端多用户模式开关（1/true/on/yes 启用多用户算力配额；不设=本地个人）
FX_CLOUD_MODE=

# 本地模拟用户套餐（free/month，默认 free；仅 FX_CLOUD_MODE=on 且未接订阅系统时的演示用）
FX_USER_PLAN=free

# 本地模拟 uid→套餐 映射（JSON 字符串，如 {"uidA":"month"}）
FX_USER_PLAN_MAP=

# 配额存储后端（memory/local/redis；云端默认 redis，连不上降级 memory 并告警）
FX_QUOTA_BACKEND=

# local 后端落盘目录（JSON）；空=纯内存，重启清零
FX_QUOTA_DIR=

# Redis 连接串（多实例共享配额状态）
FX_REDIS_URL=

# 资源 CDN 基址（指向 知识库/图片素材/，如 https://cdn.xxx.com/kb；设值后前端资源走 CDN 直链）
FX_CDN_BASE=

# =============================================================================
# 运行模式（单一主开关：环境变量切换「本地 / 云端」）—— 见 通用工具/core/runtime.py
# =============================================================================
# local（默认）= 本地个人模式，行为与改造前完全一致
# cloud        = 云端多用户：客户端面板 + 按 IP 限额 + 邀请口令 + KB 启动同步 + 反代头
AKALI_RUN_MODE=local

# 全局邀请口令（云端对外访问必填；空=不校验）。兼容旧 API_TOKEN（未设则回退）
AKALI_INVITE_CODE=

# 面板存储位置：server=服务器 user_data.json / client=浏览器本地缓存
# 留空 = 按运行模式自动（local→server，cloud→client）
AKALI_PANEL_STORE=

# 限额维度与额度（云端按 IP 计 token 总量）
AKALI_QUOTA_KEY=
FX_IP_DAILY_TOK=60000
FX_IP_DAILY_TOK_MONTH=300000

# 知识库对象存储同步（云端）：置 on 后启动时按 manifest 拉取到本地缓存
FX_KB_SYNC=
FX_KB_BASE_URL=
FX_KB_MANIFEST_URL=
FX_CLOUD_CACHE_DIR=

# 反向代理头信任（云端经 nginx/负载均衡时置 1）
AKALI_PROXY_HEADERS=

# 跨域白名单（网页端/iframe 从他域访问时填，逗号分隔；同源留空）
AKALI_ALLOW_ORIGINS=

# =============================================================================
# 【云部署链接汇总】—— 买好服务器 / 域名之后再填，现在全部留空。
# 项目内所有对外地址都不写死在代码里，统一由本文件（.env）注入；
# 下面就是全部的「链接」类配置，没有别的藏处：
#   1) 跨域白名单      AKALI_ALLOW_ORIGINS（见上；填前端站点地址，同源部署留空）
#   2) 图片素材 CDN    FX_CDN_BASE（见上；不配则回退服务器 /kb/ 路由）
#   3) 知识库对象存储  FX_KB_BASE_URL / FX_KB_MANIFEST_URL（见上；不配则用服务器本地 知识库/ 目录）
# 填写格式参考（去掉行首 # 即为生效）：
# AKALI_ALLOW_ORIGINS=https://你的域名
# FX_CDN_BASE=https://cdn.你的域名/kb
# FX_KB_BASE_URL=https://你的对象存储地址/kb
# FX_KB_MANIFEST_URL=https://你的对象存储地址/kb/manifest.json
# =============================================================================
