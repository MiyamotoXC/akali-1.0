# =============================================================================
# 阿卡莉 1.0 环境变量配置
#
# 【怎么用】复制本文件为 .env（copy .env.example .env），然后按下面两套模式之一填写：
#   · 本地模式（默认）：一段都不用改，直接用 —— 只监听 127.0.0.1、无门禁、无限额
#   · 云服务器部署    ：进【二】把「本地组」注释掉、启用「云端组」，
#                       再到【三】按需取消注释并填值（AKALI_INVITE_CODE 必填）
#
# 【结构】
#   一 = 两种模式共用（LLM / 路由 / 心跳 / 鉴权 / 开发者路径），通常无需改动
#   二 = 运行模式（本地组 与 云端组，二选一）
#   三 = 云端专用（配额 + 对外链接），默认整段注释，不写死任何地址
#
# 说明：两套配置不会互相干扰 —— 生效的是未注释行，注释行仅作模板。
# =============================================================================


# =============================================================================
# 一、通用配置（本地 / 云端共用，通常无需改动）
# =============================================================================

# --- 核心 LLM 配置 ---
# 服务商（agicto / dashscope）：决定接口地址与读取哪个 API Key 变量
LLM_PROVIDER=agicto

# API Key（填写所用服务商对应的变量；AGICTO 从 https://agicto.com 获取，
# DashScope 从 https://dashscope.console.aliyun.com 获取）
# 注意：生产环境建议用系统环境变量而非 .env 保存密钥
AGICTO_API_KEY=
DASHSCOPE_API_KEY=

# LLM 模型名
LLM_MODEL=qwen-plus

# 思考模式开关（可选，默认 0 关闭；qwen3 系列非流式调用必须关闭，否则上游 400）
LLM_ENABLE_THINKING=0

# 向量模型（攻略问答库向量化，走所选服务商 /v1/embeddings）
EMBEDDING_MODEL=text-embedding-v4

# --- 路由与功能开关 ---
# 路由模式：agent=LangChain function calling 选工具（默认）/ legacy=旧正则回退
# agent 模式下 LLM 只负责「选工具+抽参数」，工具确定性执行、回复原文直出；
# 未命中工具时回落 legacy。详见 通用工具/core/route_dispatch.py
AKALI_ROUTE_MODE=agent

# agent 模式绑定工具范围：core=12 个只读读/检索工具(默认) / full=追加更多只读工具
# AKALI_AGENT_TOOLS=core

# 聊天功能开关（默认开启，设为 0 或 false 则禁用所有 LLM 对话）
AKALI_CHAT_ENABLED=

# --- 心跳与生命周期 ---
# 自动关闭：页面关闭后自动终止服务（默认关闭，设为 1 启用；本地便利、云端勿开）
AKALI_AUTO_SHUTDOWN=

# 心跳超时秒数（默认 120，超过此时间无心跳视为页面关闭）
AKALI_HEARTBEAT_TIMEOUT=120

# 心跳发送间隔秒数（默认 30）
AKALI_HEARTBEAT_INTERVAL=30

# --- 安全（本地 / 云端都可用）---
# API Token（可选，用于前端简易鉴权；留空则不校验）
API_TOKEN=

# --- 开发者入口配置（仅数据管理工具使用，服务端可留空）---
# 知识库根目录（可选，默认 知识库/）
# KNOWLEDGE_BASE_DIR=
# 原始数据输出路径（可选，默认 知识库/底层数据/产物/raw_data.json）
# RAW_DATA_OUTPUT_PATH=
# 处理后数据输出路径（可选，默认 知识库/底层数据/产物/data.json）
# DATA_OUTPUT_PATH=


# =============================================================================
# 二、运行模式（本地组 / 云端组，二选一）
#     —— 本地跑就用「本地组」，下面的云端组保持注释；上服务器时对调。
# =============================================================================

# ---------- 【本地组】本地个人模式：行为与改造前完全一致（默认，勿改）----------
AKALI_RUN_MODE=local          # 本地个人模式：127.0.0.1 + 无门禁 + 无限额
HOST=127.0.0.1                # 仅本机访问
PORT=8000                     # 端口冲突时自动顺延 8001-8009
AKALI_NO_BROWSER=             # 留空 = 启动后自动打开浏览器
AKALI_PROXY_HEADERS=          # 留空 = 不走反代（本机直连）
AKALI_PANEL_STORE=            # 留空 = 按模式自动（本地→server：落盘 user_data.json）
FX_CLOUD_MODE=                # 留空 = 不启用多用户配额（本地不限量）
AKALI_AUTO_KILL=1             # 端口冲突时自动杀死占用进程（本地便利开关）

# ---------- 【云端组】云服务器部署：切云端时，注释掉上面「本地组」，启用这一组 ----------
# AKALI_RUN_MODE=cloud        # 云端多用户：客户端面板 + 按 IP 限额 + 邀请口令 + 反代头
# HOST=0.0.0.0                # 必须 0.0.0.0，否则容器外访问不到
# PORT=8000
# AKALI_NO_BROWSER=1          # 服务器无需自动开浏览器
# AKALI_PROXY_HEADERS=1       # 经 nginx/负载均衡必须置 1（否则按 IP 限额会全员算作同一 IP）
# AKALI_PANEL_STORE=client    # 面板随请求携带、存浏览器本地（服务器无用户文件）
# FX_CLOUD_MODE=on            # 启用多用户算力配额（不想限额就留空）
# AKALI_AUTO_KILL=            # 云端留空（勿自动杀进程）


# =============================================================================
# 三、云端专用配置（默认整段注释；切云端时按需取消注释，本地一律不动）
# =============================================================================

# --- 3.1 邀请口令与鉴权（云端必填）---
# 全局邀请口令：云端对外访问必填；空 = 不校验，公网暴露会被白嫖 LLM 额度
# AKALI_INVITE_CODE=

# --- 3.2 多用户算力配额（可选：不做限额就整段留空）---
# 配额存储后端：memory / local / redis（云端推荐 redis，跨重启不丢；compose 已内置 redis 服务）
# FX_QUOTA_BACKEND=redis
# Redis 连接串（redis 为 docker-compose 内的服务名）
# FX_REDIS_URL=redis://redis:6379/0
# local 后端落盘目录（用 redis 时可留空；compose 已把 /data 挂为持久卷）
# FX_QUOTA_DIR=/data/quota
# 本地模拟用户套餐（free/month；仅 FX_CLOUD_MODE=on 且未接订阅系统时的演示用）
# FX_USER_PLAN=free
# 本地模拟 uid→套餐 映射（JSON 字符串，如 {"uidA":"month"}）
# FX_USER_PLAN_MAP=
# 限额维度与额度（云端按 IP 计 token 总量）
# AKALI_QUOTA_KEY=
# FX_IP_DAILY_TOK=60000
# FX_IP_DAILY_TOK_MONTH=300000

# --- 3.3 云部署链接（买好服务器 / 域名 / CDN 之后填，之前保持留空）---
# 说明：项目内**所有对外地址都不写死在代码里**，只由本文件注入 —— 下面就是全部的「链接」类配置。
# 跨域白名单（网页端/iframe 从他域访问时填，逗号分隔；同源部署留空）
# AKALI_ALLOW_ORIGINS=https://你的域名
# 图片素材 CDN（指向 知识库/图片素材/；不配则回退服务器 /kb/ 路由）
# FX_CDN_BASE=https://cdn.你的域名/kb
# 知识库对象存储同步（不配则用服务器上挂载的 知识库/ 目录）
# FX_KB_SYNC=on
# FX_KB_BASE_URL=https://你的对象存储地址/kb
# FX_KB_MANIFEST_URL=https://你的对象存储地址/kb/manifest.json
# FX_CLOUD_CACHE_DIR=
# =============================================================================
